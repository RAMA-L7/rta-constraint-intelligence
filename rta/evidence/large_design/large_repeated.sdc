set sdc_version 2.2
create_clock -name clk_core -period 5.0 [get_ports clk]
set_input_delay -max 1.0 -min 0.2 -clock clk_core [all_inputs]
set_output_delay -max 1.0 -min 0.2 -clock clk_core [all_outputs]
set_false_path -from [get_pins U0/Q] -to [get_pins U1/D]
set_multicycle_path -setup 2 -hold 1 -from [get_cells R0] -to [get_cells R1]
set_max_delay 2.000 -datapath_only -from [get_pins U0/Q] -to [get_pins U1/D]
