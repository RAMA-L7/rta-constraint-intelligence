# RD08 — Large synthetic design: 60 clocks, ~360 constraints (deterministic).
# Generated by benchmark script for performance/stability measurement.
set sdc_version 2.1
set_units -time ns -capacitance pF -resistance kohm -voltage V \
          -current mA

# 60 primary clocks in 4 domains of 15
create_clock -name cpu_clk_0 -period 2.0 [get_ports cpu_clk_0]
create_clock -name cpu_clk_1 -period 2.0 [get_ports cpu_clk_1]
create_clock -name cpu_clk_2 -period 2.0 [get_ports cpu_clk_2]
create_clock -name cpu_clk_3 -period 2.0 [get_ports cpu_clk_3]
create_clock -name cpu_clk_4 -period 2.0 [get_ports cpu_clk_4]
create_clock -name cpu_clk_5 -period 2.0 [get_ports cpu_clk_5]
create_clock -name cpu_clk_6 -period 2.0 [get_ports cpu_clk_6]
create_clock -name cpu_clk_7 -period 2.0 [get_ports cpu_clk_7]
create_clock -name cpu_clk_8 -period 2.0 [get_ports cpu_clk_8]
create_clock -name cpu_clk_9 -period 2.0 [get_ports cpu_clk_9]
create_clock -name cpu_clk_10 -period 2.0 [get_ports cpu_clk_10]
create_clock -name cpu_clk_11 -period 2.0 [get_ports cpu_clk_11]
create_clock -name cpu_clk_12 -period 2.0 [get_ports cpu_clk_12]
create_clock -name cpu_clk_13 -period 2.0 [get_ports cpu_clk_13]
create_clock -name cpu_clk_14 -period 2.0 [get_ports cpu_clk_14]
create_clock -name io_clk_0 -period 10.0 [get_ports io_clk_0]
create_clock -name io_clk_1 -period 10.0 [get_ports io_clk_1]
create_clock -name io_clk_2 -period 10.0 [get_ports io_clk_2]
create_clock -name io_clk_3 -period 10.0 [get_ports io_clk_3]
create_clock -name io_clk_4 -period 10.0 [get_ports io_clk_4]
create_clock -name io_clk_5 -period 10.0 [get_ports io_clk_5]
create_clock -name io_clk_6 -period 10.0 [get_ports io_clk_6]
create_clock -name io_clk_7 -period 10.0 [get_ports io_clk_7]
create_clock -name io_clk_8 -period 10.0 [get_ports io_clk_8]
create_clock -name io_clk_9 -period 10.0 [get_ports io_clk_9]
create_clock -name io_clk_10 -period 10.0 [get_ports io_clk_10]
create_clock -name io_clk_11 -period 10.0 [get_ports io_clk_11]
create_clock -name io_clk_12 -period 10.0 [get_ports io_clk_12]
create_clock -name io_clk_13 -period 10.0 [get_ports io_clk_13]
create_clock -name io_clk_14 -period 10.0 [get_ports io_clk_14]
create_clock -name mem_clk_0 -period 3.3 [get_ports mem_clk_0]
create_clock -name mem_clk_1 -period 3.3 [get_ports mem_clk_1]
create_clock -name mem_clk_2 -period 3.3 [get_ports mem_clk_2]
create_clock -name mem_clk_3 -period 3.3 [get_ports mem_clk_3]
create_clock -name mem_clk_4 -period 3.3 [get_ports mem_clk_4]
create_clock -name mem_clk_5 -period 3.3 [get_ports mem_clk_5]
create_clock -name mem_clk_6 -period 3.3 [get_ports mem_clk_6]
create_clock -name mem_clk_7 -period 3.3 [get_ports mem_clk_7]
create_clock -name mem_clk_8 -period 3.3 [get_ports mem_clk_8]
create_clock -name mem_clk_9 -period 3.3 [get_ports mem_clk_9]
create_clock -name mem_clk_10 -period 3.3 [get_ports mem_clk_10]
create_clock -name mem_clk_11 -period 3.3 [get_ports mem_clk_11]
create_clock -name mem_clk_12 -period 3.3 [get_ports mem_clk_12]
create_clock -name mem_clk_13 -period 3.3 [get_ports mem_clk_13]
create_clock -name mem_clk_14 -period 3.3 [get_ports mem_clk_14]
create_clock -name ahb_clk_0 -period 4.0 [get_ports ahb_clk_0]
create_clock -name ahb_clk_1 -period 4.0 [get_ports ahb_clk_1]
create_clock -name ahb_clk_2 -period 4.0 [get_ports ahb_clk_2]
create_clock -name ahb_clk_3 -period 4.0 [get_ports ahb_clk_3]
create_clock -name ahb_clk_4 -period 4.0 [get_ports ahb_clk_4]
create_clock -name ahb_clk_5 -period 4.0 [get_ports ahb_clk_5]
create_clock -name ahb_clk_6 -period 4.0 [get_ports ahb_clk_6]
create_clock -name ahb_clk_7 -period 4.0 [get_ports ahb_clk_7]
create_clock -name ahb_clk_8 -period 4.0 [get_ports ahb_clk_8]
create_clock -name ahb_clk_9 -period 4.0 [get_ports ahb_clk_9]
create_clock -name ahb_clk_10 -period 4.0 [get_ports ahb_clk_10]
create_clock -name ahb_clk_11 -period 4.0 [get_ports ahb_clk_11]
create_clock -name ahb_clk_12 -period 4.0 [get_ports ahb_clk_12]
create_clock -name ahb_clk_13 -period 4.0 [get_ports ahb_clk_13]
create_clock -name ahb_clk_14 -period 4.0 [get_ports ahb_clk_14]

# Domain groups
set_clock_groups -asynchronous \
    -group [get_clocks {cpu_clk_*}] \
    -group [get_clocks {io_clk_*}] \
    -group [get_clocks {mem_clk_*}] \
    -group [get_clocks {ahb_clk_*}]

# Uncertainty per domain
set_clock_uncertainty -setup 0.05 -hold 0.03 [get_clocks {cpu_clk_*}]
set_clock_uncertainty -setup 0.2 -hold 0.1 [get_clocks {io_clk_*}]
set_clock_uncertainty -setup 0.08 -hold 0.04 [get_clocks {mem_clk_*}]
set_clock_uncertainty -setup 0.1 -hold 0.05 [get_clocks {ahb_clk_*}]

# 60 input + 60 output delays
set_input_delay -max 0.8 -min 0.2 -clock cpu_clk_0 [get_ports din_cpu_0]
set_input_delay -max 0.8 -min 0.2 -clock cpu_clk_1 [get_ports din_cpu_1]
set_input_delay -max 0.8 -min 0.2 -clock cpu_clk_2 [get_ports din_cpu_2]
