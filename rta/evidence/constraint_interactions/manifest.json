{
  "intro": "Constraint-interaction golden suite (Phase 10). Expected values were derived from SDC semantics, NOT from validator output. Categories: EXACT_DUPLICATE (SDC-067, info), OVERRIDE (SDC-068, info), DEFINITE_CONFLICT (SDC-069, warning), POSSIBLE_CONFLICT (SDC-070, info, STA review). Deferrals: SDC-002 owns duplicate/conflicting clock names; SDC-049 owns contradictory case analysis.",
  "cases": [
    {
      "id": "CI01",
      "sdc": "CI01_exact_duplicate.sdc",
      "purpose": "Exact duplicate input delay",
      "note": "Identical -max delay twice on same port/clock is redundant (second is a no-op) -> EXACT_DUPLICATE.",
      "expected": {"exact_duplicates": 1, "overrides": 0, "definite_conflicts": 0, "possible_conflicts": 0,
        "findings": [{"code": "SDC-067", "min": 1, "max": 1}]}
    },
    {
      "id": "CI02",
      "sdc": "CI02_legal_min_max.sdc",
      "purpose": "Legal min/max pair",
      "note": "-max and -min are independent analysis modes on the same object -> LEGAL_MULTIPLE, never flagged.",
      "expected": {"exact_duplicates": 0, "overrides": 0, "definite_conflicts": 0, "possible_conflicts": 0,
        "findings": []}
    },
    {
      "id": "CI03",
      "sdc": "CI03_legal_rise_fall.sdc",
      "purpose": "Legal rise/fall pair",
      "note": "-rise and -fall select different edges -> independent constraints.",
